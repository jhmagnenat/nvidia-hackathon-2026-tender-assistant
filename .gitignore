# Environment / secrets
.env
.env.*
!.env.example

# OS
.DS_Store
Thumbs.db

# Editors
.vscode/
.idea/
*.swp

# Python
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/
.mypy_cache/
.pytest_cache/
.ruff_cache/

# Node
node_modules/
dist/
build/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Logs
*.log

# Local tender documents — real/large PDFs are not committed (non-public and/or
# potentially large). The synthetic sample .txt fixtures under data/sample_tenders/*/
# are committed intentionally so the local-fallback demo works out of the box.
data/sample_tenders/**/*.pdf
data/sample_tenders/**/*.docx

# Runtime-generated human-review/feedback log (local demo state, not a fixture)
data/feedback_log.json

# Runtime-generated briefings written by the create_briefing MCP tool (local demo
# state, not a fixture)
data/briefings/

# Runtime-generated drafts written by the create_draft MCP tool (local demo
# state, not a fixture)
data/drafts/

# Runtime-generated per-tender_id workflow state (score/recommendation/
# human_review/research_requests/history), written by qualify_tender/
# create_briefing/submit_human_decision (local demo state, not a fixture)
data/workflow_state/

# Streamlit secrets (unused by this app, but never commit if added later)
.streamlit/secrets.toml

# Private Hermes state and rendered ingress
.hermes/
.nemoclaw/
*.htpasswd
*.db
*.db-*
*.sqlite*
deploy/hermes-ingress/nginx.conf
integrations/simap/*results*.json
integrations/simap/*success-check*.json
